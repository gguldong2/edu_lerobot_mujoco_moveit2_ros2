<?xml version="1.0"?>
<!--
  so101_ros2_control_backends.xacro

  Copy of so101_description/urdf/ros2_control/so101_ros2_control.xacro
  (legalaspro/so101-ros-physical-ai, Apache-2.0) with one addition:
  a third `hardware_type` branch for MuJoCo.

  Upstream README lists hardware_type as: real | mock (`mujoco` planned, not yet
  supported) - so this file is where that planned slot is implemented.

  Joint list, motor ids and the Feetech parameters are kept identical to upstream so
  that the same URDF works for mock, mujoco and real without touching joint names.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Renamed from upstream `so101_control_joint` to avoid a macro name clash if the
       upstream file is ever included in the same document. -->
  <xacro:macro name="so101_backend_control_joint" params="variant joint id">
    <joint name="${joint}">
      <param name="id">${id}</param>
      <!-- follower can be commanded; leader is state-only -->
      <xacro:if value="${variant == 'follower'}">
        <command_interface name="position"/>
        <param name="p_coefficient">16</param>
        <param name="i_coefficient">0</param>
        <param name="d_coefficient">32</param>
        <xacro:if value="${joint == 'gripper'}">
          <param name="max_torque_limit">500</param>
          <param name="protection_current">250</param>
          <param name="overload_torque">25</param>
        </xacro:if>
      </xacro:if>

      <state_interface name="position"/>
      <state_interface name="velocity"/>

      <param name="return_delay_time">0</param>
      <param name="acceleration">254</param>
    </joint>
  </xacro:macro>

  <xacro:macro name="so101_ros2_control_backends" params="
      variant:='follower'
      hardware_type:='mock'
      usb_port:='/dev/ttyACM0'
      joint_config_file:=''
      mujoco_model:=''
      mujoco_headless:='false'
      mujoco_keyframe:=''
      sim_speed_factor:='1.0'
      system_name:='SO101_SYSTEM'">

    <ros2_control name="${system_name}" type="system">
      <hardware>
        <!-- 1) mock: connection test only, no physics -->
        <xacro:if value="${hardware_type == 'mock'}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>

        <!-- 2) mujoco: physics simulation through mujoco_ros2_control.
             NOTE: requires the ros2_control_node shipped by mujoco_ros2_control,
             not the plain controller_manager one. See launch/bringup.launch.py. -->
        <xacro:if value="${hardware_type == 'mujoco'}">
          <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
          <param name="mujoco_model">${mujoco_model}</param>
          <!-- normalise to the lowercase strings ros2_control compares against:
               xacro would otherwise emit Python-style True/False -->
          <param name="headless">${'true' if mujoco_headless in [True, 'true', 'True', '1', 1] else 'false'}</param>
          <param name="sim_speed_factor">${sim_speed_factor}</param>
          <!-- optional: start from a named MJCF keyframe (scene.xml has "rest").
               Param name follows the demo URDF; leave empty to skip it. -->
          <xacro:if value="${mujoco_keyframe != ''}">
            <param name="initial_keyframe">${mujoco_keyframe}</param>
          </xacro:if>
        </xacro:if>

        <!-- 3) real: Feetech STS3215 servos (upstream submodule driver) -->
        <xacro:if value="${hardware_type == 'real'}">
          <plugin>feetech_ros2_driver/FeetechHardwareInterface</plugin>
          <param name="usb_port">${usb_port}</param>
          <param name="joint_config_file">${joint_config_file}</param>
        </xacro:if>
      </hardware>

      <!-- arm joints (motor ids follow the upstream calibration order) -->
      <xacro:so101_backend_control_joint variant="${variant}" joint="shoulder_pan"  id="1"/>
      <xacro:so101_backend_control_joint variant="${variant}" joint="shoulder_lift" id="2"/>
      <xacro:so101_backend_control_joint variant="${variant}" joint="elbow_flex"    id="3"/>
      <xacro:so101_backend_control_joint variant="${variant}" joint="wrist_flex"    id="4"/>
      <xacro:so101_backend_control_joint variant="${variant}" joint="wrist_roll"    id="5"/>
      <xacro:so101_backend_control_joint variant="${variant}" joint="gripper"       id="6"/>
    </ros2_control>
  </xacro:macro>
</robot>
