<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>so101_project</name>
  <version>0.1.0</version>
  <description>
    SO-101 arm/gripper group control with MoveIt 2 over three interchangeable ros2_control
    backends: mock, MuJoCo (mujoco_ros2_control) and real Feetech servos.
    Model and MoveIt config are reused from legalaspro/so101-ros-physical-ai.
  </description>
  <maintainer email="dy.jung@skaiworldwide.co.kr">dy.jung</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- model -->
  <exec_depend>so101_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <!-- control -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>ros2_controllers_test_nodes</exec_depend>

  <!-- moveit -->
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>pick_ik</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>

  <!-- simulation backend (optional at runtime) -->
  <exec_depend>mujoco_ros2_control</exec_depend>

  <!-- python client -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
